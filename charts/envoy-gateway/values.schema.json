{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "APPLICATION_NAME": {
            "type": "string",
            "description": "Application name applied as app.kubernetes.io/part-of label on all resources"
        },
        "MANAGED_BY": {
            "type": "string",
            "description": "Value for the app.kubernetes.io/managed-by label"
        },
        "SERVICE_NAME": {
            "type": "string",
            "description": "Service name used in resource labels and metadata"
        },
        "global": {
            "type": "object",
            "description": "Global image references shared with the envoy-gateway-cr chart",
            "properties": {
                "images": {
                    "type": "object",
                    "properties": {
                        "envoy": {
                            "type": "object",
                            "properties": {
                                "image": {
                                    "type": "string",
                                    "description": "Full envoy proxy image reference (registry/repo:tag)"
                                }
                            }
                        },
                        "envoyGateway": {
                            "type": "object",
                            "properties": {
                                "image": {
                                    "type": "string",
                                    "description": "Full Envoy Gateway controller image reference"
                                }
                            }
                        },
                        "ratelimit": {
                            "type": "object",
                            "properties": {
                                "image": {
                                    "type": "string",
                                    "description": "Full rate-limit sidecar image reference"
                                }
                            }
                        }
                    }
                }
            }
        },
        "gateway-helm": {
            "type": "object",
            "description": "Values passed through to the upstream envoyproxy/gateway-helm subchart",
            "properties": {
                "certgen": {
                    "type": "object",
                    "description": "Certificate generation job that produces TLS credentials for the gateway controller",
                    "properties": {
                        "job": {
                            "type": "object",
                            "properties": {
                                "affinity": {
                                    "type": "object",
                                    "description": "Pod affinity rules for the certgen job"
                                },
                                "annotations": {
                                    "type": "object",
                                    "description": "Annotations added to the certgen job"
                                },
                                "nodeSelector": {
                                    "type": "object",
                                    "description": "Node selector for the certgen job pod"
                                },
                                "resources": {
                                    "type": "object",
                                    "description": "Compute resource requests for the certgen job",
                                    "properties": {
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string",
                                                    "description": "CPU request (e.g. 100m)"
                                                },
                                                "memory": {
                                                    "type": "string",
                                                    "description": "Memory request (e.g. 256Mi)"
                                                }
                                            }
                                        }
                                    }
                                },
                                "securityContext": {
                                    "$ref": "#/$defs/containerSecurityContext",
                                    "description": "Security context for the certgen job container"
                                },
                                "tolerations": {
                                    "type": "array",
                                    "description": "Tolerations for the certgen job pod"
                                },
                                "ttlSecondsAfterFinished": {
                                    "type": "integer",
                                    "description": "Seconds to retain the Job object after it completes",
                                    "minimum": 0
                                }
                            }
                        },
                        "rbac": {
                            "type": "object",
                            "properties": {
                                "annotations": {
                                    "type": "object"
                                },
                                "labels": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "config": {
                    "type": "object",
                    "description": "Envoy Gateway controller configuration",
                    "properties": {
                        "envoyGateway": {
                            "type": "object",
                            "properties": {
                                "gateway": {
                                    "type": "object",
                                    "properties": {
                                        "controllerName": {
                                            "type": "string",
                                            "description": "Controller name used to reconcile GatewayClass resources"
                                        }
                                    }
                                },
                                "logging": {
                                    "type": "object",
                                    "properties": {
                                        "level": {
                                            "type": "object",
                                            "properties": {
                                                "default": {
                                                    "type": "string",
                                                    "description": "Default log level for the gateway controller",
                                                    "enum": ["debug", "info", "warn", "error"]
                                                }
                                            }
                                        }
                                    }
                                },
                                "provider": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "description": "Infrastructure provider type",
                                            "enum": ["Kubernetes"]
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "createNamespace": {
                    "type": "boolean",
                    "description": "Whether the subchart should create the gateway namespace"
                },
                "deployment": {
                    "type": "object",
                    "properties": {
                        "envoyGateway": {
                            "type": "object",
                            "description": "Gateway controller container configuration",
                            "properties": {
                                "image": {
                                    "type": "object",
                                    "properties": {
                                        "repository": {
                                            "type": "string",
                                            "description": "Image repository (overrides global.images.envoyGateway.image)"
                                        },
                                        "tag": {
                                            "type": "string",
                                            "description": "Image tag (overrides global.images.envoyGateway.image)"
                                        }
                                    }
                                },
                                "imagePullPolicy": {
                                    "type": "string",
                                    "description": "Image pull policy; empty string defers to Kubernetes default",
                                    "enum": ["Always", "IfNotPresent", "Never", ""]
                                },
                                "imagePullSecrets": {
                                    "type": "array",
                                    "description": "Image pull secrets for the gateway controller container"
                                },
                                "resources": {
                                    "type": "object",
                                    "description": "Compute resource requests and limits for the gateway controller",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "securityContext": {
                                    "$ref": "#/$defs/containerSecurityContext",
                                    "description": "Security context for the gateway controller container"
                                }
                            }
                        },
                        "pod": {
                            "type": "object",
                            "description": "Pod-level configuration for the gateway controller",
                            "properties": {
                                "affinity": {
                                    "type": "object",
                                    "description": "Pod affinity and anti-affinity rules"
                                },
                                "annotations": {
                                    "type": "object",
                                    "description": "Annotations added to the gateway controller pod"
                                },
                                "labels": {
                                    "type": "object",
                                    "description": "Additional labels added to the gateway controller pod"
                                },
                                "nodeSelector": {
                                    "type": "object",
                                    "description": "Node selector for the gateway controller pod"
                                },
                                "tolerations": {
                                    "type": "array",
                                    "description": "Tolerations for the gateway controller pod"
                                },
                                "topologySpreadConstraints": {
                                    "type": "array",
                                    "description": "Topology spread constraints for the gateway controller pod"
                                }
                            }
                        },
                        "ports": {
                            "type": "array",
                            "description": "Service ports exposed by the gateway controller",
                            "items": {
                                "type": "object",
                                "required": ["name", "port", "targetPort"],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "port": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 65535
                                    },
                                    "targetPort": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 65535
                                    }
                                }
                            }
                        },
                        "priorityClassName": {
                            "type": ["string", "null"],
                            "description": "Priority class name for the gateway controller pod"
                        },
                        "replicas": {
                            "type": "integer",
                            "description": "Number of gateway controller replicas",
                            "minimum": 0
                        }
                    }
                },
                "global": {
                    "type": "object",
                    "description": "Subchart-level image and RBAC configuration",
                    "properties": {
                        "images": {
                            "type": "object",
                            "properties": {
                                "envoyGateway": {
                                    "type": "object",
                                    "properties": {
                                        "image": {
                                            "type": "string"
                                        },
                                        "pullPolicy": {
                                            "type": "string",
                                            "description": "Image pull policy for the gateway controller",
                                            "enum": ["Always", "IfNotPresent", "Never"]
                                        },
                                        "pullSecrets": {
                                            "type": "array"
                                        }
                                    }
                                },
                                "ratelimit": {
                                    "type": "object",
                                    "properties": {
                                        "image": {
                                            "type": "string"
                                        },
                                        "pullPolicy": {
                                            "type": "string",
                                            "description": "Image pull policy for the rate-limit sidecar",
                                            "enum": ["Always", "IfNotPresent", "Never"]
                                        },
                                        "pullSecrets": {
                                            "type": "array"
                                        }
                                    }
                                }
                            }
                        },
                        "rbac": {
                            "type": "object",
                            "properties": {
                                "create": {
                                    "type": "boolean",
                                    "description": "Whether to create ClusterRole and ClusterRoleBinding resources"
                                }
                            }
                        }
                    }
                },
                "kubernetesClusterDomain": {
                    "type": "string",
                    "description": "Kubernetes cluster domain used for internal DNS (default: cluster.local)"
                },
                "podDisruptionBudget": {
                    "type": "object",
                    "description": "PodDisruptionBudget for the gateway controller",
                    "properties": {
                        "minAvailable": {
                            "type": "integer",
                            "description": "Minimum number of available pods during disruptions",
                            "minimum": 0
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "description": "Service configuration for the gateway controller",
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "description": "Annotations added to the gateway controller Service"
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "containerSecurityContext": {
            "type": "object",
            "description": "Kubernetes container security context",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "add": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "privileged": {
                    "type": "boolean"
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer",
                    "minimum": 0
                },
                "runAsGroup": {
                    "type": "integer",
                    "minimum": 0
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": ["RuntimeDefault", "Localhost", "Unconfined"]
                        },
                        "localhostProfile": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
